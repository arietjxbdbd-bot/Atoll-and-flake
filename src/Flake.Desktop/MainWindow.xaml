<Window x:Class="Flake.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flake Desktop"
        Width="1000" Height="680"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="FLAKE DESKTOP" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="A little winter on your desktop."
                       FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock Text="The foundation is in place. The winter features are being built."
                       FontSize="14" Foreground="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}"
                CornerRadius="18" Padding="24" Margin="0,28,0,24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="560">
                <TextBlock Text="Welcome to Flake" FontSize="25" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="This is the first development scaffold, not the finished application."
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,22"
                           Foreground="{StaticResource SecondaryText}"/>
                <UniformGrid Columns="2" Rows="2">
                    <Border Margin="6" Padding="16" CornerRadius="12" Background="#253343">
                        <StackPanel>
                            <TextBlock Text="SNOW ENGINE" FontWeight="SemiBold"/>
                            <TextBlock Text="Planned" Foreground="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="6" Padding="16" CornerRadius="12" Background="#253343">
                        <StackPanel>
                            <TextBlock Text="ATOLL ISLAND" FontWeight="SemiBold"/>
                            <TextBlock Text="Integration planned" Foreground="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="6" Padding="16" CornerRadius="12" Background="#253343">
                        <StackPanel>
                            <TextBlock Text="PENGUINS" FontWeight="SemiBold"/>
                            <TextBlock Text="Planned" Foreground="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="6" Padding="16" CornerRadius="12" Background="#253343">
                        <StackPanel>
                            <TextBlock Text="PC MANAGER" FontWeight="SemiBold"/>
                            <TextBlock Text="Planned" Foreground="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2">
            <TextBlock Text="FLAKE DESKTOP  •  EARLY DEVELOPMENT"
                       Foreground="{StaticResource SecondaryText}" FontSize="11"/>
            <TextBlock Text=".NET 10  •  Windows 10 / 11"
                       Foreground="{StaticResource SecondaryText}" FontSize="11"
                       DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
