<Window x:Class="Flake.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Flake Desktop" Width="1180" Height="760" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{StaticResource Flake.Background}" Foreground="{StaticResource Flake.Text}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#0E1929" Padding="20"><DockPanel><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="2,4,0,30"><Border Width="38" Height="38" CornerRadius="12" Background="#243F59"><TextBlock Text="❄" FontSize="23" Foreground="{StaticResource Flake.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="FLAKE" FontSize="17" FontWeight="Bold"/><TextBlock Text="DESKTOP" FontSize="9" Foreground="{StaticResource Flake.Muted}"/></StackPanel></StackPanel><TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Flake.Muted}" Margin="8,0,0,12"/><Button Content="Dashboard" Tag="0" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Content="Snow Engine" Tag="1" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Content="Accumulation" Tag="2" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Content="Penguins" Tag="3" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Content="Snowman Builder" Tag="4" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Content="Snow Cleaner" Tag="5" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Content="PC Manager" Tag="6" Click="Navigate_Click" Style="{StaticResource NavButton}"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><Button Content="Settings" Tag="7" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Content="About" Tag="8" Click="Navigate_Click" Style="{StaticResource NavButton}"/><TextBlock Text="STANDALONE WINDOWS APP" FontSize="9" Foreground="{StaticResource Flake.Muted}" Margin="8,18,0,0"/><TextBlock Text=".NET 10  •  WIN 10 / 11" FontSize="9" Foreground="{StaticResource Flake.Muted}" Margin="8,5,0,0"/></StackPanel></DockPanel></Border><Grid Grid.Column="1" Margin="34,28,34,28"><TabControl x:Name="Sections" Background="Transparent" BorderThickness="0"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources><TabItem Header="Dashboard"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="DASHBOARD" Foreground="{StaticResource Flake.Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Your winter desktop." FontSize="34" FontWeight="SemiBold" Margin="0,9,0,5"/><TextBlock Text="A calm winter atmosphere, with every effect under your control." Foreground="{StaticResource Flake.Muted}" FontSize="14" Margin="0,0,0,26"/><Border Background="{StaticResource Flake.Surface}" CornerRadius="18" Padding="24" Margin="0,0,0,18"><StackPanel><TextBlock Text="FLAKE DESKTOP" FontSize="12" Foreground="{StaticResource Flake.Accent}" FontWeight="Bold"/><TextBlock Text="A fresh start." FontSize="25" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="The standalone foundation is being assembled. Each feature is isolated in its own module and will be enabled as it passes implementation and testing." TextWrapping="Wrap" Foreground="{StaticResource Flake.Muted}" FontSize="14" MaxWidth="720"/></StackPanel></Border><UniformGrid Columns="2" Rows="2"><Border Background="{StaticResource Flake.Surface}" CornerRadius="14" Padding="18" Margin="0,0,12,12"><StackPanel><TextBlock Text="01  SNOW ENGINE" Foreground="{StaticResource Flake.Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Particle simulation" FontSize="18" Margin="0,8,0,4"/><TextBlock Text="Independent physics module" Foreground="{StaticResource Flake.Muted}"/></StackPanel></Border><Border Background="{StaticResource Flake.Surface}" CornerRadius="14" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="02  DESKTOP OVERLAY" Foreground="{StaticResource Flake.Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Multi-monitor layer" FontSize="18" Margin="0,8,0,4"/><TextBlock Text="Isolated Win32 integration" Foreground="{StaticResource Flake.Muted}"/></StackPanel></Border><Border Background="{StaticResource Flake.Surface}" CornerRadius="14" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="03  CHARACTERS" Foreground="{StaticResource Flake.Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Penguins &amp; snowman" FontSize="18" Margin="0,8,0,4"/><TextBlock Text="Independent interaction module" Foreground="{StaticResource Flake.Muted}"/></StackPanel></Border><Border Background="{StaticResource Flake.Surface}" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="04  PC MANAGER" Foreground="{StaticResource Flake.Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Windows utilities" FontSize="18" Margin="0,8,0,4"/><TextBlock Text="Safe, user-confirmed operations" Foreground="{StaticResource Flake.Muted}"/></StackPanel></Border></UniformGrid></StackPanel></ScrollViewer></TabItem><TabItem Header="Snow Engine"><StackPanel><TextBlock Text="SNOW ENGINE" Foreground="{StaticResource Flake.Accent}" FontWeight="Bold"/><TextBlock Text="Snow simulation" FontSize="30" Margin="0,8"/><TextBlock Text="Particle physics will be implemented in the dedicated Flake.SnowEngine module." Foreground="{StaticResource Flake.Muted}"/></StackPanel></TabItem><TabItem Header="Accumulation"><StackPanel><TextBlock Text="ACCUMULATION" Foreground="{StaticResource Flake.Accent}" FontWeight="Bold"/><TextBlock Text="Snow layers" FontSize="30" Margin="0,8"/><TextBlock Text="Screen and window surface tracking is part of the desktop overlay milestone." Foreground="{StaticResource Flake.Muted}"/></StackPanel></TabItem><TabItem Header="Penguins"><StackPanel><TextBlock Text="CHARACTERS" Foreground="{StaticResource Flake.Accent}" FontWeight="Bold"/><TextBlock Text="Penguins" FontSize="30" Margin="0,8"/><TextBlock Text="Character state and behavior will live outside the UI layer." Foreground="{StaticResource Flake.Muted}"/></StackPanel></TabItem><TabItem Header="Snowman"><StackPanel><TextBlock Text="BUILDER" Foreground="{StaticResource Flake.Accent}" FontWeight="Bold"/><TextBlock Text="Snowman Builder" FontSize="30" Margin="0,8"/><TextBlock Text="Composition and saved designs will be isolated in Flake.Snowman." Foreground="{StaticResource Flake.Muted}"/></StackPanel></TabItem><TabItem Header="Cleaner"><StackPanel><TextBlock Text="CLEANER" Foreground="{StaticResource Flake.Accent}" FontWeight="Bold"/><TextBlock Text="Snow Cleaner" FontSize="30" Margin="0,8"/><TextBlock Text="Snow clearing actions will be explicit and reversible where possible." Foreground="{StaticResource Flake.Muted}"/></StackPanel></TabItem><TabItem Header="PC Manager"><StackPanel><TextBlock Text="SYSTEM TOOLS" Foreground="{StaticResource Flake.Accent}" FontWeight="Bold"/><TextBlock Text="PC Manager" FontSize="30" Margin="0,8"/><TextBlock Text="System operations will require confirmation and use supported Windows mechanisms." Foreground="{StaticResource Flake.Muted}"/></StackPanel></TabItem><TabItem Header="Settings"><StackPanel><TextBlock Text="PREFERENCES" Foreground="{StaticResource Flake.Accent}" FontWeight="Bold"/><TextBlock Text="Settings" FontSize="30" Margin="0,8"/><TextBlock Text="Settings storage is provided by the standalone JSON settings module." Foreground="{StaticResource Flake.Muted}"/></StackPanel></TabItem><TabItem Header="About"><StackPanel><TextBlock Text="ABOUT" Foreground="{StaticResource Flake.Accent}" FontWeight="Bold"/><TextBlock Text="Flake Desktop" FontSize="30" Margin="0,8"/><TextBlock Text="An independent Windows desktop application. No Atoll runtime or source dependency." Foreground="{StaticResource Flake.Muted}"/></StackPanel></TabItem></TabControl></Grid></Grid></Window>